# Copy to .env for local development. Never commit .env.

# Public site URL (canonical links; Phase 4 QR code).
PUBLIC_SITE_URL=https://example.com

# Supabase project (Project Settings -> API).
SUPABASE_URL=https://xxxx.supabase.co
# anon key: used by the /admin panel on the server. RLS applies.
# For local `wrangler dev`, put SUPABASE_URL and SUPABASE_ANON_KEY in .dev.vars instead.
SUPABASE_ANON_KEY=
# service-role key: build script only. Bypasses RLS. Never shipped to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Local-only escape hatch: build from src/data/menu.json instead of Supabase.
# Never set this in Cloudflare.
# MENU_SOURCE=json
