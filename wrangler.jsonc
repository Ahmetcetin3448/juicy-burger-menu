{
  // Cloudflare Workers config. The Astro adapter fills in `main` (the SSR
  // entry for /admin) and the static assets directory at build time; the
  // deployable config is written to dist/server/wrangler.json.
  "name": "juicy-burger-menu",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "404-page"
  }
}
