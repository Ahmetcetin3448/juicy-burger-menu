---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { admin } from '../../i18n/admin';

export const prerender = false;

// Middleware guarantees a signed-in admin here.
const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login', 303);
---

<AdminLayout title={admin.home.heading} userEmail={user.email}>
  <h1 class="font-display text-3xl uppercase tracking-wide">{admin.home.heading}</h1>
  <p class="mt-2 text-sm text-muted">{admin.signedInAs}: {user.email}</p>
</AdminLayout>
